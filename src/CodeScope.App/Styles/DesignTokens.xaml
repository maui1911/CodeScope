<!--
    Design tokens derived from docs/DESIGN.md — the Framer-inspired system.

    Philosophy:
      - Binary surface: pure void black (#000000) + pure white ink (#ffffff)
      - ONE accent only: Framer Blue (#0099ff) — links, focus rings, interactive borders
      - Pill geometry on every interactive CTA (40–100px radius); never squared
      - Frosted glass via rgba(255,255,255,0.1) on dark — NOT blur
      - Blue-tinted ring shadow rgba(0,153,255,0.15) is the signature containment move
      - NO decorative gradients in chrome (DESIGN.md §7 "Don't")

    We keep the `Fig.*` keys that are already consumed by live XAML (tabs, status bar,
    sidebar PROJECTS label, diff header). New Framer-native tokens are layered alongside
    under the `Framer.*` and `Surface.*` / `Space.*` / `Radius.*` namespaces.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ========================================================================= -->
    <!-- §2 COLOR PALETTE                                                           -->
    <!-- ========================================================================= -->

    <!-- Binary ink / canvas -->
    <Color x:Key="Fig.Color.Ink">#FFFFFFFF</Color>
    <Color x:Key="Fig.Color.Canvas">#FF000000</Color>
    <Color x:Key="Fig.Color.InkMuted">#FFA6A6A6</Color>   <!-- Muted Silver  §2.Secondary -->
    <Color x:Key="Fig.Color.InkDim">#99FFFFFF</Color>     <!-- Ghost White (0.60 alpha) -->
    <Color x:Key="Fig.Color.InkGhost">#66FFFFFF</Color>   <!-- 0.40 alpha placeholders -->
    <Color x:Key="Fig.Color.Divider">#22FFFFFF</Color>
    <Color x:Key="Fig.Color.NearBlack">#FF090909</Color>  <!-- §2 elevated dark surface -->

    <!-- Framer Blue — THE single accent color (§2, §7 "Don'ts: no additional accents") -->
    <Color x:Key="Framer.Color.Blue">#FF0099FF</Color>
    <Color x:Key="Framer.Color.BlueGlow">#260099FF</Color>        <!-- rgba(0,153,255,0.15) -->
    <Color x:Key="Framer.Color.BlueGlowSoft">#140099FF</Color>    <!-- 0.08 for hover halo -->

    <!-- Frosted glass tiers -->
    <Color x:Key="Framer.Color.Frost10">#1AFFFFFF</Color>   <!-- 0.10 — button surface -->
    <Color x:Key="Framer.Color.Frost20">#33FFFFFF</Color>   <!-- 0.20 — hover state    -->
    <Color x:Key="Framer.Color.Frost50">#80FFFFFF</Color>   <!-- 0.50 — emphasis hover -->

    <!-- Brushes -->
    <SolidColorBrush x:Key="Fig.Brush.Ink"         Color="{StaticResource Fig.Color.Ink}" />
    <SolidColorBrush x:Key="Fig.Brush.Canvas"      Color="{StaticResource Fig.Color.Canvas}" />
    <SolidColorBrush x:Key="Fig.Brush.InkMuted"    Color="{StaticResource Fig.Color.InkMuted}" />
    <SolidColorBrush x:Key="Fig.Brush.InkDim"      Color="{StaticResource Fig.Color.InkDim}" />
    <SolidColorBrush x:Key="Fig.Brush.InkGhost"    Color="{StaticResource Fig.Color.InkGhost}" />
    <SolidColorBrush x:Key="Fig.Brush.Divider"     Color="{StaticResource Fig.Color.Divider}" />
    <SolidColorBrush x:Key="Fig.Brush.NearBlack"   Color="{StaticResource Fig.Color.NearBlack}" />

    <SolidColorBrush x:Key="Fig.Brush.GlassDark"   Color="{StaticResource Framer.Color.Frost10}" />
    <SolidColorBrush x:Key="Fig.Brush.GlassLight"  Color="{StaticResource Framer.Color.Frost20}" />
    <SolidColorBrush x:Key="Fig.Brush.GlassHover"  Color="{StaticResource Framer.Color.Frost50}" />
    <SolidColorBrush x:Key="Fig.Brush.SurfaceDialog" Color="#F2090909" />

    <SolidColorBrush x:Key="Framer.Brush.Blue"     Color="{StaticResource Framer.Color.Blue}" />
    <SolidColorBrush x:Key="Framer.Brush.BlueGlow" Color="{StaticResource Framer.Color.BlueGlow}" />
    <SolidColorBrush x:Key="Framer.Brush.BlueGlowSoft" Color="{StaticResource Framer.Color.BlueGlowSoft}" />

    <!-- Semantic aliases expected by views -->
    <SolidColorBrush x:Key="Surface.Canvas"   Color="{StaticResource Fig.Color.Canvas}" />
    <SolidColorBrush x:Key="Surface.Panel"    Color="{StaticResource Fig.Color.NearBlack}" />
    <SolidColorBrush x:Key="Surface.Frost"    Color="{StaticResource Framer.Color.Frost10}" />
    <SolidColorBrush x:Key="Surface.Hover"    Color="{StaticResource Framer.Color.Frost20}" />
    <SolidColorBrush x:Key="Text.Primary"     Color="{StaticResource Fig.Color.Ink}" />
    <SolidColorBrush x:Key="Text.Secondary"   Color="{StaticResource Fig.Color.InkMuted}" />
    <SolidColorBrush x:Key="Text.Tertiary"    Color="{StaticResource Fig.Color.InkDim}" />
    <SolidColorBrush x:Key="Text.Placeholder" Color="{StaticResource Fig.Color.InkGhost}" />
    <SolidColorBrush x:Key="Accent.Primary"   Color="{StaticResource Framer.Color.Blue}" />
    <SolidColorBrush x:Key="Accent.Ring"      Color="{StaticResource Framer.Color.BlueGlow}" />

    <!-- Extra surface + signal tokens lifted from the Overview mock (codescope-shared.css).
         Hardcoded exact design values so grid cards, status dots, and the "on" filter pill
         all render pixel-identically to the HTML reference. -->
    <Color x:Key="Surface.Color.Elev">#FF141414</Color>
    <Color x:Key="Surface.Color.Border">#FF1F1F1F</Color>
    <Color x:Key="Surface.Color.AccentRowBg">#FF11161C</Color>
    <Color x:Key="Signal.Color.Ok">#FF4BD87B</Color>
    <Color x:Key="Signal.Color.Warn">#FFFF5A5A</Color>
    <Color x:Key="Text.Color.Faint">#FF606060</Color>
    <Color x:Key="Code.Color.String">#FF8FD679</Color>
    <Color x:Key="Code.Color.Type">#FFE8A857</Color>
    <Color x:Key="Accent.Color.Soft">#330099FF</Color>   <!-- rgba(0,153,255,0.20) -->
    <Color x:Key="Accent.Color.Glow">#660099FF</Color>   <!-- rgba(0,153,255,0.40) -->

    <SolidColorBrush x:Key="Surface.Elev"         Color="{StaticResource Surface.Color.Elev}" />
    <SolidColorBrush x:Key="Surface.Border"       Color="{StaticResource Surface.Color.Border}" />
    <SolidColorBrush x:Key="Surface.AccentRowBg"  Color="{StaticResource Surface.Color.AccentRowBg}" />
    <SolidColorBrush x:Key="Signal.Ok"            Color="{StaticResource Signal.Color.Ok}" />
    <SolidColorBrush x:Key="Signal.Warn"          Color="{StaticResource Signal.Color.Warn}" />
    <SolidColorBrush x:Key="Text.Faint"           Color="{StaticResource Text.Color.Faint}" />
    <SolidColorBrush x:Key="Code.String"          Color="{StaticResource Code.Color.String}" />
    <SolidColorBrush x:Key="Code.Type"            Color="{StaticResource Code.Color.Type}" />
    <SolidColorBrush x:Key="Accent.Soft"          Color="{StaticResource Accent.Color.Soft}" />
    <SolidColorBrush x:Key="Accent.Glow"          Color="{StaticResource Accent.Color.Glow}" />

    <!-- ========================================================================= -->
    <!-- §5 SPACING SCALE — base 8, full Framer ladder                              -->
    <!-- ========================================================================= -->
    <sys:Double x:Key="Space.1">1</sys:Double>
    <sys:Double x:Key="Space.2">2</sys:Double>
    <sys:Double x:Key="Space.3">3</sys:Double>
    <sys:Double x:Key="Space.4">4</sys:Double>
    <sys:Double x:Key="Space.5">5</sys:Double>
    <sys:Double x:Key="Space.6">6</sys:Double>
    <sys:Double x:Key="Space.8">8</sys:Double>
    <sys:Double x:Key="Space.10">10</sys:Double>
    <sys:Double x:Key="Space.12">12</sys:Double>
    <sys:Double x:Key="Space.15">15</sys:Double>
    <sys:Double x:Key="Space.20">20</sys:Double>
    <sys:Double x:Key="Space.30">30</sys:Double>
    <sys:Double x:Key="Space.35">35</sys:Double>
    <sys:Double x:Key="Space.60">60</sys:Double>
    <sys:Double x:Key="Space.80">80</sys:Double>

    <!-- Thickness presets (most common combos) -->
    <Thickness x:Key="Pad.Tight">6,4</Thickness>
    <Thickness x:Key="Pad.Default">10,6</Thickness>
    <Thickness x:Key="Pad.Comfortable">15,10</Thickness>
    <Thickness x:Key="Pad.Dialog">30,20</Thickness>

    <!-- ========================================================================= -->
    <!-- §5/§4 RADIUS SCALE                                                         -->
    <!-- ========================================================================= -->
    <CornerRadius x:Key="Fig.Radius.Small">6</CornerRadius>
    <CornerRadius x:Key="Fig.Radius.Medium">8</CornerRadius>
    <CornerRadius x:Key="Fig.Radius.Pill">50</CornerRadius>

    <CornerRadius x:Key="Radius.Micro">1</CornerRadius>
    <CornerRadius x:Key="Radius.Soft">7</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">15</CornerRadius>
    <CornerRadius x:Key="Radius.Large">20</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">100</CornerRadius>

    <!-- ========================================================================= -->
    <!-- §6 ELEVATION — Framer's inverted shadow system                             -->
    <!-- ========================================================================= -->
    <!-- Level-1 BlueGlow ring: simulated via Border BorderBrush={Accent.Ring} + 1px -->
    <!-- Level-3 Floating: DropShadowEffect on interactive overlays only             -->
    <DropShadowEffect x:Key="Shadow.Floating"
                      BlurRadius="30"
                      ShadowDepth="10"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.25" />
    <DropShadowEffect x:Key="Shadow.Dialog"
                      BlurRadius="40"
                      ShadowDepth="12"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.55" />

    <!-- ========================================================================= -->
    <!-- §3 TYPOGRAPHY                                                              -->
    <!-- ========================================================================= -->
    <!-- Framer uses GT Walsheim / Inter / Azeret Mono, none of which ship with
         Windows. We fall back to the closest Windows-native equivalents:
         Segoe UI Variable (variable-weight sans), Cascadia Mono (geometric mono). -->
    <FontFamily x:Key="Fig.Font.Sans">Segoe UI Variable Display, Segoe UI Variable, Segoe UI, Inter, system-ui</FontFamily>
    <FontFamily x:Key="Fig.Font.Mono">FiraCode Nerd Font Mono, Cascadia Mono, Cascadia Code, Consolas, Azeret Mono, menlo</FontFamily>
    <FontFamily x:Key="Fig.Font.Display">Segoe UI Variable Display, Segoe UI, Inter, system-ui</FontFamily>

    <!-- Size scale — scaled down from web 110/85/62/32px to desktop-app proportions.
         DESIGN.md's type hierarchy is preserved but compressed for dense UI. -->
    <sys:Double x:Key="Fig.Size.Display">42</sys:Double>
    <sys:Double x:Key="Fig.Size.SectionDisplay">32</sys:Double>
    <sys:Double x:Key="Fig.Size.SectionHeading">24</sys:Double>
    <sys:Double x:Key="Fig.Size.Heading">18</sys:Double>
    <sys:Double x:Key="Fig.Size.SubHeading">15</sys:Double>
    <sys:Double x:Key="Fig.Size.BodyLarge">14</sys:Double>
    <sys:Double x:Key="Fig.Size.Body">13</sys:Double>
    <sys:Double x:Key="Fig.Size.BodySmall">12</sys:Double>
    <sys:Double x:Key="Fig.Size.Label">12</sys:Double>
    <sys:Double x:Key="Fig.Size.Caption">11</sys:Double>
    <sys:Double x:Key="Fig.Size.MonoLabel">11</sys:Double>
    <sys:Double x:Key="Fig.Size.MonoSmall">10</sys:Double>
    <sys:Double x:Key="Fig.Size.Micro">9</sys:Double>

    <!-- Framer's signature negative tracking — proportional to size -->
    <sys:Double x:Key="Fig.LetterSpacing.Display">-2.10</sys:Double>   <!-- -5%-ish -->
    <sys:Double x:Key="Fig.LetterSpacing.Heading">-0.96</sys:Double>
    <sys:Double x:Key="Fig.LetterSpacing.SubHeading">-0.80</sys:Double>
    <sys:Double x:Key="Fig.LetterSpacing.Body">-0.14</sys:Double>
    <sys:Double x:Key="Fig.LetterSpacing.Nav">-0.15</sys:Double>
    <sys:Double x:Key="Fig.LetterSpacing.Uppercase">0.84</sys:Double>  <!-- positive for small caps -->

    <!-- ========================================================================= -->
    <!-- TEXT STYLES                                                                -->
    <!-- ========================================================================= -->

    <Style x:Key="Fig.Style.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fig.Font.Display}" />
        <Setter Property="FontSize"   Value="{StaticResource Fig.Size.Display}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource Fig.Brush.Ink}" />
        <Setter Property="LineHeight" Value="38" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Fig.Style.Heading" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fig.Font.Display}" />
        <Setter Property="FontSize"   Value="{StaticResource Fig.Size.Heading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Fig.Brush.Ink}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- MonoLabel: uppercase micro-caps — PROJECTS / DIFF / STATUS -->
    <Style x:Key="Fig.Style.MonoLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fig.Font.Mono}" />
        <Setter Property="FontSize"   Value="{StaticResource Fig.Size.MonoLabel}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Fig.Brush.InkMuted}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="Fig.Style.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fig.Font.Sans}" />
        <Setter Property="FontSize"   Value="{StaticResource Fig.Size.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Fig.Brush.Ink}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Fig.Style.BodyMuted" TargetType="TextBlock" BasedOn="{StaticResource Fig.Style.Body}">
        <Setter Property="Foreground" Value="{StaticResource Fig.Brush.InkMuted}" />
    </Style>

    <Style x:Key="Fig.Style.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Fig.Font.Sans}" />
        <Setter Property="FontSize"   Value="{StaticResource Fig.Size.Caption}" />
        <Setter Property="Foreground" Value="{StaticResource Fig.Brush.InkMuted}" />
    </Style>

    <!-- ========================================================================= -->
    <!-- §4 FOCUS VISUAL — Framer Blue 2px solid ring (primary) and dashed (alt)    -->
    <!-- ========================================================================= -->
    <Style x:Key="Framer.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle
                        Margin="-3"
                        Stroke="{StaticResource Framer.Brush.Blue}"
                        StrokeThickness="2"
                        SnapsToDevicePixels="True"
                        RadiusX="8" RadiusY="8" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Fig.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle
                        Margin="-2"
                        Stroke="{StaticResource Framer.Brush.Blue}"
                        StrokeThickness="2"
                        StrokeDashArray="2,2"
                        SnapsToDevicePixels="True"
                        RadiusX="6" RadiusY="6" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- §4 BUTTONS                                                                 -->
    <!-- ========================================================================= -->

    <!-- Solid White Pill — the primary CTA (§4 "Solid White Pill"). 100px radius. -->
    <Style x:Key="Fig.Style.Button.Pill" TargetType="Button">
        <Setter Property="Background"  Value="{StaticResource Fig.Brush.Ink}" />
        <Setter Property="Foreground"  Value="{StaticResource Fig.Brush.Canvas}" />
        <Setter Property="FontFamily"  Value="{StaticResource Fig.Font.Sans}" />
        <Setter Property="FontSize"    Value="{StaticResource Fig.Size.Body}" />
        <Setter Property="FontWeight"  Value="Medium" />
        <Setter Property="Padding"     Value="15,10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor"      Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Fig.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="PillBg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextBlock.FontFamily="{TemplateBinding FontFamily}"
                            TextBlock.FontSize="{TemplateBinding FontSize}"
                            TextBlock.FontWeight="{TemplateBinding FontWeight}"
                            TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PillBg" Property="Background" Value="{StaticResource Fig.Brush.GlassHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PillBg" Property="Background" Value="{StaticResource Fig.Brush.InkMuted}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Frosted Pill — secondary CTA (§4 "Frosted Pill"). 40px radius feel, rgba(255,255,255,0.1). -->
    <Style x:Key="Fig.Style.Button.Glass" TargetType="Button">
        <Setter Property="Background"  Value="{StaticResource Fig.Brush.GlassDark}" />
        <Setter Property="Foreground"  Value="{StaticResource Fig.Brush.Ink}" />
        <Setter Property="FontFamily"  Value="{StaticResource Fig.Font.Sans}" />
        <Setter Property="FontSize"    Value="{StaticResource Fig.Size.Body}" />
        <Setter Property="FontWeight"  Value="Medium" />
        <Setter Property="Padding"     Value="15,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor"      Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Fig.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="GlassBg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextBlock.FontFamily="{TemplateBinding FontFamily}"
                            TextBlock.FontSize="{TemplateBinding FontSize}"
                            TextBlock.FontWeight="{TemplateBinding FontWeight}"
                            TextBlock.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GlassBg" Property="Background" Value="{StaticResource Fig.Brush.GlassLight}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="GlassBg" Property="Background" Value="{StaticResource Fig.Brush.GlassHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost — text-only, hover reveals frost (§4 "Ghost"). -->
    <Style x:Key="Fig.Style.Button.Ghost" TargetType="Button">
        <Setter Property="Background"  Value="Transparent" />
        <Setter Property="Foreground"  Value="{StaticResource Fig.Brush.Ink}" />
        <Setter Property="FontFamily"  Value="{StaticResource Fig.Font.Sans}" />
        <Setter Property="FontSize"    Value="{StaticResource Fig.Size.Body}" />
        <Setter Property="FontWeight"  Value="Medium" />
        <Setter Property="Padding"     Value="12,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor"      Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Fig.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="GhostBg"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Pill}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GhostBg" Property="Background" Value="{StaticResource Fig.Brush.GlassDark}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="GhostBg" Property="Background" Value="{StaticResource Fig.Brush.GlassLight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- §4 INPUTS — TextBox with Framer Blue focus border                          -->
    <!-- ========================================================================= -->
    <Style x:Key="Fig.Style.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource Fig.Font.Sans}" />
        <Setter Property="FontSize"   Value="{StaticResource Fig.Size.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Fig.Brush.Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Framer.Brush.Blue}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Framer.Brush.Blue}" />
        <Setter Property="Background" Value="{StaticResource Fig.Brush.GlassDark}" />
        <Setter Property="BorderBrush" Value="{StaticResource Fig.Brush.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Fig.Radius.Small}"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Framer.Brush.Blue}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Fig.Brush.GlassLight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- §4 CARDS / CONTAINERS                                                      -->
    <!-- ========================================================================= -->

    <!-- Dark Surface Card: near-black background + 1px Framer blue-glow ring (§4). -->
    <Style x:Key="Fig.Style.Card" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource Fig.Brush.NearBlack}" />
        <Setter Property="BorderBrush"     Value="{StaticResource Framer.Brush.BlueGlow}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource Radius.Card}" />
        <Setter Property="Padding"         Value="{StaticResource Pad.Comfortable}" />
    </Style>

    <!-- Dialog Surface: elevated near-black, floating shadow. §5 standard-component
         radius (8px) — DESIGN.md treats 10–15px as "large containers", which reads
         too card-y for modal dialogs. -->
    <Style x:Key="Fig.Style.Dialog" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource Fig.Brush.SurfaceDialog}" />
        <Setter Property="BorderBrush"     Value="{StaticResource Framer.Brush.BlueGlow}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource Fig.Radius.Medium}" />
        <Setter Property="Effect"          Value="{StaticResource Shadow.Dialog}" />
    </Style>

    <!-- Tab pill (active state) -->
    <Style x:Key="Fig.Style.Tab.Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Fig.Radius.Pill}" />
        <Setter Property="Padding"      Value="14,6" />
        <Setter Property="Background"   Value="{StaticResource Fig.Brush.GlassDark}" />
    </Style>

    <!-- Pill primitive -->
    <Style x:Key="Fig.Style.Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Fig.Radius.Pill}" />
        <Setter Property="Padding"      Value="10,4" />
    </Style>

</ResourceDictionary>
