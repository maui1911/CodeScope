<!--
    Context-menu styling lifted from docs/design/html/CodeScope - Context Menu.html
    (codescope-shared.css .mi, .menu, .msep, .mgroup).

    Applied globally (default styles, no x:Key) so the dynamic TreeContextMenu in
    SidebarView picks up the look without touching the code-behind that builds it.

    Icons are StreamGeometry resources with keys "Ctx.Icon.*"; the code-behind
    pulls them by key and wraps them in a Path for MenuItem.Icon.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Surface tokens specific to this menu (kept local — they're not reused elsewhere). -->
    <Color x:Key="Ctx.Color.Panel">#FF141414</Color>
    <Color x:Key="Ctx.Color.Border">#FF2A2A2A</Color>
    <Color x:Key="Ctx.Color.Divider">#FF1F1F1F</Color>
    <Color x:Key="Ctx.Color.ItemText">#FFE6E6E6</Color>
    <Color x:Key="Ctx.Color.Hover">#1F0099FF</Color>       <!-- accent @ 12% -->
    <Color x:Key="Ctx.Color.Active">#2E0099FF</Color>      <!-- accent @ 18% — .mi.active resting bg -->
    <Color x:Key="Ctx.Color.ActiveHover">#3D0099FF</Color> <!-- accent @ 24% — .mi.active:hover -->
    <Color x:Key="Ctx.Color.AccentBorder">#730099FF</Color><!-- accent @ 45% — .mi.active inset ring -->
    <Color x:Key="Ctx.Color.Danger">#FFFF8A8A</Color>
    <Color x:Key="Ctx.Color.DangerHover">#1FFF5A5A</Color>

    <SolidColorBrush x:Key="Ctx.Panel"        Color="{StaticResource Ctx.Color.Panel}" />
    <SolidColorBrush x:Key="Ctx.Border"       Color="{StaticResource Ctx.Color.Border}" />
    <SolidColorBrush x:Key="Ctx.Divider"      Color="{StaticResource Ctx.Color.Divider}" />
    <SolidColorBrush x:Key="Ctx.ItemText"     Color="{StaticResource Ctx.Color.ItemText}" />
    <SolidColorBrush x:Key="Ctx.Hover"        Color="{StaticResource Ctx.Color.Hover}" />
    <SolidColorBrush x:Key="Ctx.Active"       Color="{StaticResource Ctx.Color.Active}" />
    <SolidColorBrush x:Key="Ctx.ActiveHover"  Color="{StaticResource Ctx.Color.ActiveHover}" />
    <SolidColorBrush x:Key="Ctx.AccentBorder" Color="{StaticResource Ctx.Color.AccentBorder}" />
    <SolidColorBrush x:Key="Ctx.Danger"       Color="{StaticResource Ctx.Color.Danger}" />
    <SolidColorBrush x:Key="Ctx.DangerHover"  Color="{StaticResource Ctx.Color.DangerHover}" />

    <!-- ================ Icon geometries (14×14 viewBox, stroked @ 1.4px) ================
         Paths mirror the SVGs in CodeScope - Context Menu.html. Using simplified
         sharp-corner rectangles instead of rx= arcs keeps the XAML readable while
         rendering identically at 14px target size. -->

    <!-- Open session / terminal: rectangle + ">" arrow + dash -->
    <StreamGeometry x:Key="Ctx.Icon.Terminal">M1.5,2.5 H12.5 V11.5 H1.5 Z M3.5,5.5 L5.5,7 L3.5,8.5 M6.5,8.5 H10</StreamGeometry>

    <!-- Open in new group: two stacked rects -->
    <StreamGeometry x:Key="Ctx.Icon.SplitGroup">M1.5,2.5 H6.5 V11.5 H1.5 Z M7.5,2.5 H12.5 V11.5 H7.5 Z</StreamGeometry>

    <!-- Restart: circle + clock hand -->
    <StreamGeometry x:Key="Ctx.Icon.Restart">M12,7 A5,5 0 1 1 2,7 A5,5 0 1 1 12,7 Z M7,4 V7 L9,8.5</StreamGeometry>

    <!-- Create PR: three circles linked into a Y -->
    <StreamGeometry x:Key="Ctx.Icon.PullRequest">M5.3,3.5 A1.3,1.3 0 1 1 2.7,3.5 A1.3,1.3 0 1 1 5.3,3.5 Z M11.3,7 A1.3,1.3 0 1 1 8.7,7 A1.3,1.3 0 1 1 11.3,7 Z M5.3,10.5 A1.3,1.3 0 1 1 2.7,10.5 A1.3,1.3 0 1 1 5.3,10.5 Z M4,4.8 V9.2 M4,7 Q7,7 8.7,7</StreamGeometry>

    <!-- Pull (fast-forward): down arrow -->
    <StreamGeometry x:Key="Ctx.Icon.Pull">M7,2 V10 M4,7 L7,10 L10,7</StreamGeometry>

    <!-- Rebase: arrow + base line -->
    <StreamGeometry x:Key="Ctx.Icon.Rebase">M7,2 V10 M4,7 L7,10 L10,7 M3,12 H11</StreamGeometry>

    <!-- Trash: lid + can + handle + slats -->
    <StreamGeometry x:Key="Ctx.Icon.Trash">M2,4 H12 M3,4 V11.5 L4,12 H10 L11,11.5 V4 M5.5,2.5 H8.5 M6,6.5 V10 M8,6.5 V10</StreamGeometry>

    <!-- Folder (Reveal) -->
    <StreamGeometry x:Key="Ctx.Icon.Folder">M2.5,3 H6 L7.5,4.5 H11.5 L12.5,5.5 V10.5 L11.5,11.5 H2.5 L1.5,10.5 V4 Z</StreamGeometry>

    <!-- Windows Terminal: rectangle + ">" prompt -->
    <StreamGeometry x:Key="Ctx.Icon.WinTerminal">M1.5,2.5 H12.5 V11.5 H1.5 Z M3.5,5.5 L5.5,7 L3.5,8.5 M6.5,8.5 H10</StreamGeometry>

    <!-- Clipboard (Copy) -->
    <StreamGeometry x:Key="Ctx.Icon.Clipboard">M2,2 H10 V12 H2 Z M4,5 H8 M4,7 H8 M4,9 H6.5</StreamGeometry>

    <!-- Clipboard alt with cutout (Path copy) -->
    <StreamGeometry x:Key="Ctx.Icon.ClipboardPath">M2,2 H10 V12 H2 Z M4,5 H8 M4,7 H8</StreamGeometry>

    <!-- Branch ref icon (copy branch) -->
    <StreamGeometry x:Key="Ctx.Icon.Branch">M5.3,3.5 A1.3,1.3 0 1 1 2.7,3.5 A1.3,1.3 0 1 1 5.3,3.5 Z M11.3,10.5 A1.3,1.3 0 1 1 8.7,10.5 A1.3,1.3 0 1 1 11.3,10.5 Z M4,4.8 V9 M4,9 Q4,10.5 6,10.5 H8.5</StreamGeometry>

    <!-- SHA (hash) -->
    <StreamGeometry x:Key="Ctx.Icon.Hash">M12,7 A5,5 0 1 1 2,7 A5,5 0 1 1 12,7 Z M4.5,7 H9.5 M7,4.5 V9.5</StreamGeometry>

    <!-- Link / URL -->
    <StreamGeometry x:Key="Ctx.Icon.Link">M1.5,3 H12.5 V11 H1.5 Z M1.5,5 H12.5</StreamGeometry>

    <!-- Pencil (Rename) -->
    <StreamGeometry x:Key="Ctx.Icon.Pencil">M3,3 L11,3 L11,6 M8,6 H11 V9 M2,9 H9 V12 H2 Z</StreamGeometry>

    <!-- Plus sign (New worktree / add) -->
    <StreamGeometry x:Key="Ctx.Icon.Plus">M7,2 V12 M2,7 H12</StreamGeometry>

    <!-- Download (Fetch all) -->
    <StreamGeometry x:Key="Ctx.Icon.Download">M7,2 V9 M4,6 L7,9 L10,6 M2,12 H12</StreamGeometry>

    <!-- ================ Leaf item template (default) ================
         28px tall, 5px radius, Inter 12.5, shortcut mono 10px right. -->
    <ControlTemplate x:Key="Ctx.Menu.ItemTemplate" TargetType="MenuItem">
        <Border
            x:Name="Bd"
            Background="Transparent"
            CornerRadius="5"
            Margin="0,1"
            Padding="10,0"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" SharedSizeGroup="CtxIcon" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter
                    x:Name="IconHost"
                    Grid.Column="0"
                    ContentSource="Icon"
                    Width="14"
                    Height="14"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    SnapsToDevicePixels="True"
                    TextBlock.Foreground="{DynamicResource Text.Secondary}" />

                <ContentPresenter
                    x:Name="HeaderHost"
                    Grid.Column="1"
                    ContentSource="Header"
                    Margin="10,0,8,0"
                    VerticalAlignment="Center"
                    RecognizesAccessKey="True"
                    TextBlock.FontFamily="{DynamicResource Fig.Font.Sans}"
                    TextBlock.FontSize="12.5"
                    TextBlock.Foreground="{TemplateBinding Foreground}" />

                <TextBlock
                    x:Name="Shortcut"
                    Grid.Column="2"
                    Text="{TemplateBinding InputGestureText}"
                    FontFamily="{DynamicResource Fig.Font.Mono}"
                    FontSize="10"
                    Foreground="{DynamicResource Text.Faint}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ctx.Hover}" />
                <Setter TargetName="IconHost" Property="TextBlock.Foreground" Value="{DynamicResource Accent.Primary}" />
                <Setter TargetName="Shortcut" Property="Foreground" Value="{DynamicResource Accent.Primary}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ================ Primary leaf — accent-tinted "active" action ================
         Mirrors `.mi.active` in codescope-shared.css: resting bg = accent @ 18%,
         inset 1px accent ring, hover bumps the bg to accent @ 24%. Icon + shortcut
         stay in Accent.Primary across both states since the item is already the
         accented focal point. -->
    <ControlTemplate x:Key="Ctx.Menu.PrimaryTemplate" TargetType="MenuItem">
        <Border
            x:Name="Bd"
            Background="{StaticResource Ctx.Active}"
            BorderBrush="{StaticResource Ctx.AccentBorder}"
            BorderThickness="1"
            CornerRadius="5"
            Margin="0,1"
            Padding="9,0"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" SharedSizeGroup="CtxIcon" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter
                    x:Name="IconHost"
                    Grid.Column="0"
                    ContentSource="Icon"
                    Width="14" Height="14"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    SnapsToDevicePixels="True"
                    TextBlock.Foreground="{DynamicResource Accent.Primary}" />

                <ContentPresenter
                    Grid.Column="1"
                    ContentSource="Header"
                    Margin="10,0,8,0"
                    VerticalAlignment="Center"
                    RecognizesAccessKey="True"
                    TextBlock.FontFamily="{DynamicResource Fig.Font.Sans}"
                    TextBlock.FontSize="12.5"
                    TextBlock.Foreground="{DynamicResource Text.Primary}" />

                <TextBlock
                    Grid.Column="2"
                    Text="{TemplateBinding InputGestureText}"
                    FontFamily="{DynamicResource Fig.Font.Mono}"
                    FontSize="10"
                    Foreground="{DynamicResource Accent.Primary}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ctx.ActiveHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ================ Danger leaf — Remove action ================ -->
    <ControlTemplate x:Key="Ctx.Menu.DangerTemplate" TargetType="MenuItem">
        <Border
            x:Name="Bd"
            Background="Transparent"
            CornerRadius="5"
            Margin="0,1"
            Padding="10,0"
            SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" SharedSizeGroup="CtxIcon" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ContentPresenter
                    x:Name="IconHost"
                    Grid.Column="0"
                    ContentSource="Icon"
                    Width="14" Height="14"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    TextBlock.Foreground="{DynamicResource Ctx.Danger}" />

                <ContentPresenter
                    Grid.Column="1"
                    ContentSource="Header"
                    Margin="10,0,8,0"
                    VerticalAlignment="Center"
                    RecognizesAccessKey="True"
                    TextBlock.FontFamily="{DynamicResource Fig.Font.Sans}"
                    TextBlock.FontSize="12.5"
                    TextBlock.Foreground="{DynamicResource Ctx.Danger}" />

                <TextBlock
                    Grid.Column="2"
                    Text="{TemplateBinding InputGestureText}"
                    FontFamily="{DynamicResource Fig.Font.Mono}"
                    FontSize="10"
                    Foreground="{DynamicResource Ctx.Danger}"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ctx.DangerHover}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ================ Group label — "SESSION" / "GIT" / "REVEAL" ================
         9.5px mono-ish caps, non-interactive. -->
    <ControlTemplate x:Key="Ctx.Menu.GroupTemplate" TargetType="MenuItem">
        <Border Background="Transparent" Padding="10,8,10,4">
            <TextBlock
                Text="{TemplateBinding Header}"
                FontFamily="{DynamicResource Fig.Font.Sans}"
                FontSize="9.5"
                FontWeight="Medium"
                Foreground="{DynamicResource Text.Faint}"
                Typography.Capitals="AllSmallCaps" />
        </Border>
    </ControlTemplate>

    <!-- ================ Contextual header row ================
         Small status dot + branch name + right-aligned repo. MenuItem.Header is
         expected to be a StackPanel/Grid built in code-behind. -->
    <ControlTemplate x:Key="Ctx.Menu.ContextHeaderTemplate" TargetType="MenuItem">
        <Border
            Background="Transparent"
            BorderBrush="{DynamicResource Ctx.Divider}"
            BorderThickness="0,0,0,1"
            Padding="10,6,10,8"
            Margin="0,0,0,4"
            HorizontalAlignment="Stretch">
            <!-- Stretch so the 4-column grid built in code-behind (dot / branch / * / repo)
                 fills the full menu width and the repo label lands flush-right. Without
                 Stretch on both the Border and the ContentPresenter, the header sizes to
                 content and the "repo" cell bunches next to the branch name. -->
            <ContentPresenter
                ContentSource="Header"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                RecognizesAccessKey="False" />
        </Border>
    </ControlTemplate>

    <!-- ================ SubmenuHeader — item with a child popup ================ -->
    <ControlTemplate x:Key="Ctx.Menu.SubHeaderTemplate" TargetType="MenuItem">
        <Grid>
            <Border
                x:Name="Bd"
                Background="Transparent"
                CornerRadius="5"
                Margin="0,1"
                Padding="10,0"
                SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="14" SharedSizeGroup="CtxIcon" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ContentPresenter
                        x:Name="IconHost"
                        Grid.Column="0"
                        ContentSource="Icon"
                        Width="14" Height="14"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        TextBlock.Foreground="{DynamicResource Text.Secondary}" />

                    <ContentPresenter
                        Grid.Column="1"
                        ContentSource="Header"
                        Margin="10,0,8,0"
                        VerticalAlignment="Center"
                        RecognizesAccessKey="True"
                        TextBlock.FontFamily="{DynamicResource Fig.Font.Sans}"
                        TextBlock.FontSize="12.5"
                        TextBlock.Foreground="{TemplateBinding Foreground}" />

                    <Path
                        Grid.Column="2"
                        Width="8" Height="10"
                        Stretch="Uniform"
                        Data="M4,2 L7,5 L4,8"
                        Stroke="{DynamicResource Text.Faint}"
                        StrokeThickness="1.3"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Popup
                x:Name="SubmenuPopup"
                AllowsTransparency="True"
                Placement="Right"
                HorizontalOffset="6"
                VerticalOffset="-6"
                IsOpen="{TemplateBinding IsSubmenuOpen}"
                Focusable="False"
                PopupAnimation="Fade">
                <!-- MinWidth 220 matches .menu .menu in codescope-shared.css; offset 6 matches
                     `left: calc(100% + 6px)` in the same block. -->
                <Border
                    Background="{DynamicResource Ctx.Panel}"
                    BorderBrush="{DynamicResource Ctx.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    MinWidth="220"
                    SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="32" ShadowDepth="12" Opacity="0.55" Color="#000000" />
                    </Border.Effect>
                    <ItemsPresenter Grid.IsSharedSizeScope="True" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ctx.Hover}" />
                <Setter TargetName="IconHost" Property="TextBlock.Foreground" Value="{DynamicResource Accent.Primary}" />
                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Ctx.Hover}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ================ Default MenuItem style ================
         Picks the right template via Tag / Role triggers. -->
    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource Fig.Font.Sans}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource Ctx.ItemText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="28" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template" Value="{StaticResource Ctx.Menu.ItemTemplate}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource Ctx.Menu.SubHeaderTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource Ctx.Menu.SubHeaderTemplate}" />
            </Trigger>
            <!-- Non-interactive group label. -->
            <Trigger Property="Tag" Value="group">
                <Setter Property="Template" Value="{StaticResource Ctx.Menu.GroupTemplate}" />
                <Setter Property="Height" Value="24" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Trigger>
            <!-- Non-interactive contextual header with status dot. -->
            <Trigger Property="Tag" Value="header">
                <Setter Property="Template" Value="{StaticResource Ctx.Menu.ContextHeaderTemplate}" />
                <Setter Property="Height" Value="32" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Focusable" Value="False" />
            </Trigger>
            <!-- Red/destructive. -->
            <Trigger Property="Tag" Value="danger">
                <Setter Property="Template" Value="{StaticResource Ctx.Menu.DangerTemplate}" />
            </Trigger>
            <!-- Accent-tinted primary action ("Open session"). -->
            <Trigger Property="Tag" Value="primary">
                <Setter Property="Template" Value="{StaticResource Ctx.Menu.PrimaryTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================ Separator in a menu ================ -->
    <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
        <Setter Property="Background" Value="{DynamicResource Ctx.Divider}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,6,4,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Fill="{TemplateBinding Background}" Height="1" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================ ContextMenu panel ================ -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource Ctx.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Ctx.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Ctx.ItemText}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MinWidth" Value="260" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="12" Opacity="0.55" Color="#000000" />
                        </Border.Effect>
                        <ItemsPresenter
                            KeyboardNavigation.DirectionalNavigation="Cycle"
                            Grid.IsSharedSizeScope="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
