<Window
    x:Class="NoScope.CodeScope.Ui.Dialogs.CommandPaletteDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:NoScope.CodeScope.Ui.ViewModels"
    xmlns:conv="clr-namespace:NoScope.CodeScope.Ui.Converters"
    Title="Command palette"
    Width="620"
    Height="460"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    WindowStyle="None"
    AllowsTransparency="True"
    ResizeMode="NoResize"
    Background="Transparent"
    TextElement.Foreground="{DynamicResource Fig.Brush.Ink}"
    TextElement.FontFamily="{DynamicResource Fig.Font.Sans}"
    TextElement.FontSize="{DynamicResource Fig.Size.Body}"
    d:DataContext="{d:DesignInstance Type=vm:CommandPaletteViewModel}"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />
    </Window.Resources>
    <Border
        Background="{DynamicResource Fig.Brush.SurfaceDialog}"
        CornerRadius="{DynamicResource Fig.Radius.Medium}"
        BorderBrush="{DynamicResource Accent.Ring}"
        BorderThickness="1"
        Effect="{DynamicResource Shadow.Dialog}"
        Margin="40"
        Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Row="0"
                Text="COMMAND PALETTE"
                Style="{DynamicResource Fig.Style.MonoLabel}"
                Margin="2,0,0,10" />
            <TextBox
                Grid.Row="1"
                x:Name="QueryBox"
                AutomationProperties.AutomationId="PaletteQueryBox"
                Style="{DynamicResource Fig.Style.TextBox}"
                Margin="0,0,0,10"
                Padding="12,8"
                FontSize="14"
                Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="OnQueryKeyDown" />
            <ListBox
                Grid.Row="2"
                x:Name="Results"
                AutomationProperties.AutomationId="PaletteResultsList"
                ItemsSource="{Binding Filtered}"
                SelectedItem="{Binding Selected}"
                BorderThickness="0"
                Background="Transparent"
                Foreground="{DynamicResource Fig.Brush.Ink}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                MouseDoubleClick="OnResultsDoubleClick"
                KeyDown="OnResultsKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border
                                        x:Name="ItemBg"
                                        Background="Transparent"
                                        CornerRadius="{DynamicResource Fig.Radius.Small}"
                                        Padding="10,6"
                                        Margin="0,1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource Fig.Brush.GlassDark}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource Fig.Brush.GlassLight}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:PaletteAction}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="{Binding Icon}"
                                FontSize="14"
                                VerticalAlignment="Top"
                                Margin="0,1,8,0"
                                Foreground="{DynamicResource Fig.Brush.InkMuted}" />
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <TextBlock
                                    Text="{Binding Title}"
                                    FontSize="{DynamicResource Fig.Size.Body}"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Fig.Brush.Ink}" />
                                <TextBlock
                                    Text="{Binding Subtitle}"
                                    FontFamily="{DynamicResource Fig.Font.Mono}"
                                    FontSize="{DynamicResource Fig.Size.MonoSmall}"
                                    Foreground="{DynamicResource Fig.Brush.InkMuted}"
                                    Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</Window>
