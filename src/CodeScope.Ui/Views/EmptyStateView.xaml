<UserControl
    x:Class="NoScope.CodeScope.Ui.Views.EmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{DynamicResource Surface.Canvas}"
    TextElement.Foreground="{DynamicResource Text.Primary}"
    TextElement.FontFamily="{DynamicResource Fig.Font.Sans}">
    <!-- First-run hero. Shown when Sidebar.IsEmpty == true (no projects registered).
         Mirrors docs/design/html/CodeScope - Empty State.html — central wordmark with
         accent dot, CTA row, quick-row with three ghost actions.

         Background atmosphere (radial glow, faint grid, orbit dots) is intentionally
         understated vs the mock — WPF's DropShadowEffect is cheap but cascading
         rasterized glows over a 1440×900 surface tank GPU for no gain on a first-run
         screen; we keep just the accent radial gradient behind the CTA. -->
    <Grid>
        <!-- Behind-CTA accent glow pad. -->
        <Border
            Width="480" Height="180"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Margin="0,80,0,0"
            IsHitTestVisible="False"
            CornerRadius="90"
            Opacity="0.55">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Color="#500099FF" Offset="0" />
                    <GradientStop Color="#000099FF" Offset="1" />
                </RadialGradientBrush>
            </Border.Background>
            <Border.Effect>
                <BlurEffect Radius="24" />
            </Border.Effect>
        </Border>

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="760">

            <!-- Eyebrow -->
            <TextBlock
                HorizontalAlignment="Center"
                Text="NO PROJECTS"
                FontFamily="{DynamicResource Fig.Font.Mono}"
                FontSize="11"
                Foreground="{DynamicResource Text.Faint}"
                Typography.Capitals="AllSmallCaps"
                Margin="0,0,0,20" />

            <!-- Wordmark: 'Add a project' + accent dot. WPF can't tint a text mid-run
                 without per-Run Foreground, so we compose inline. -->
            <TextBlock
                HorizontalAlignment="Center"
                FontFamily="{DynamicResource Fig.Font.Sans}"
                FontSize="64"
                FontWeight="SemiBold"
                LineHeight="64">
                <Run Text="Add a project" Foreground="{DynamicResource Text.Primary}" /><Run
                    Text="."
                    Foreground="{DynamicResource Accent.Primary}" />
            </TextBlock>

            <!-- Tagline -->
            <TextBlock
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                MaxWidth="480"
                Margin="0,16,0,0"
                FontSize="14"
                LineHeight="21"
                Foreground="{DynamicResource Text.Secondary}">
                <Run Text="CodeScope groups " /><Run
                    Text="Git worktrees" FontWeight="Medium" Foreground="{DynamicResource Text.Primary}" /><Run
                    Text=" under projects and attaches an agent session to each one. Point it at a repo to get started." />
            </TextBlock>

            <!-- CTA row -->
            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Margin="0,28,0,0">
                <!-- Primary: Add your first project (Ctrl+N not bound today — reuses AddProjectCommand;
                     the kbd glyph shows the spec value even though the real shortcut is Ctrl+Shift+N
                     for "new worktree" later; for now: clicking is authoritative). -->
                <Button
                    AutomationProperties.AutomationId="EmptyStateAddProjectBtn"
                    Height="44"
                    Padding="18,0"
                    Background="{DynamicResource Accent.Primary}"
                    Foreground="Black"
                    BorderThickness="0"
                    FontFamily="{DynamicResource Fig.Font.Sans}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Command="{Binding Sidebar.AddProjectCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="PrimaryBg"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Add your first project"
                                               FontFamily="{TemplateBinding FontFamily}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontWeight="{TemplateBinding FontWeight}"
                                               Foreground="{TemplateBinding Foreground}"
                                               VerticalAlignment="Center" />
                                    <Border
                                        Margin="10,0,0,0"
                                        Padding="7,3"
                                        CornerRadius="3"
                                        Background="#38000000">
                                        <TextBlock
                                            Text="⌃ N"
                                            FontFamily="{DynamicResource Fig.Font.Mono}"
                                            FontSize="11"
                                            Foreground="#B3000000" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PrimaryBg" Property="Background" Value="#FF29A8FF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button
                    AutomationProperties.AutomationId="EmptyStateCloneBtn"
                    Margin="10,0,0,0"
                    Height="44"
                    Padding="14,0"
                    Background="Transparent"
                    Foreground="{DynamicResource Text.Secondary}"
                    BorderThickness="0"
                    FontFamily="{DynamicResource Fig.Font.Sans}"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    IsEnabled="False"
                    ToolTip="Clone from Git URL (coming soon)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="GhostBg"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GhostBg" Property="Background" Value="{DynamicResource Surface.Hover}" />
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="Clone from Git URL" />
                </Button>
            </StackPanel>

            <!-- Quick-row: three ghost action chips. Only the first wires to a live command
                 (AddProject via folder drop); others are inert/ToolTip placeholders — keeps
                 the design affordance while the behaviours arrive. -->
            <Border
                Margin="0,32,0,0"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource Surface.Border}"
                Background="#800A0A0A">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="▸" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Accent.Primary}"
                                       Opacity="0.9"
                                       FontFamily="{DynamicResource Fig.Font.Mono}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Drop a folder to begin"
                                       FontFamily="{DynamicResource Fig.Font.Mono}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2" Padding="6,2" CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Surface.Border}">
                                <TextBlock Text="drag"
                                           FontFamily="{DynamicResource Fig.Font.Mono}"
                                           FontSize="10"
                                           Foreground="{DynamicResource Text.Faint}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource Surface.Border}" />

                    <Border Grid.Column="2" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="▸" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Accent.Primary}"
                                       Opacity="0.9"
                                       FontFamily="{DynamicResource Fig.Font.Mono}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Open command palette"
                                       FontFamily="{DynamicResource Fig.Font.Mono}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2" Padding="6,2" CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Surface.Border}">
                                <TextBlock Text="⌃ K"
                                           FontFamily="{DynamicResource Fig.Font.Mono}"
                                           FontSize="10"
                                           Foreground="{DynamicResource Text.Faint}" />
                            </Border>
                        </Grid>
                    </Border>

                    <Rectangle Grid.Column="3" Width="1" Fill="{DynamicResource Surface.Border}" />

                    <Border Grid.Column="4" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="▸" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Accent.Primary}"
                                       Opacity="0.9"
                                       FontFamily="{DynamicResource Fig.Font.Mono}"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Session overview"
                                       FontFamily="{DynamicResource Fig.Font.Mono}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Text.Secondary}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="2" Padding="6,2" CornerRadius="3"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource Surface.Border}">
                                <TextBlock Text="⌃⇧ O"
                                           FontFamily="{DynamicResource Fig.Font.Mono}"
                                           FontSize="10"
                                           Foreground="{DynamicResource Text.Faint}" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
