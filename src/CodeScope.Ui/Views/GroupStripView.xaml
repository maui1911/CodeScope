<UserControl
    x:Class="NoScope.CodeScope.Ui.Views.GroupStripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:NoScope.CodeScope.Ui.ViewModels"
    xmlns:conv="clr-namespace:NoScope.CodeScope.Ui.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:EditorGroupViewModel}">
    <UserControl.Resources>
        <conv:TabStatusToBrushConverter x:Key="TabDotBrush" />
        <BooleanToVisibilityConverter x:Key="BoolVisible" />
    </UserControl.Resources>
    <!--
        One editor group's 40px tab strip, hosted in the title-bar row of MainWindow
        (not in the workspace). Tabs bind to the group's Tabs / SelectedTab. A 2px
        Accent rail at the bottom marks IsFocused. The adjacent EditorGroupView in
        Row 1 renders the matching workspace column.
    -->
    <Border
        Background="{DynamicResource Surface.Panel}"
        BorderBrush="{DynamicResource Surface.Border}"
        BorderThickness="0,0,1,0"
        AllowDrop="True"
        DragOver="OnStripDragOver"
        Drop="OnStripDrop"
        PreviewMouseDown="OnStripPreviewMouseDown">
        <Grid>
            <DockPanel LastChildFill="True" Margin="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch">
                    <!-- Tab Motion spec (docs/design/html/CodeScope - Tab Motion.html):
                         one 3px rail that slides between tabs on select. 200ms ease-out
                         on Canvas.Left + Width; the Border above StripList sits in a
                         Canvas so we can animate Left independently of layout flow. -->
                    <Grid x:Name="StripHost" VerticalAlignment="Stretch">
                    <ListBox
                        x:Name="StripList"
                        AutomationProperties.AutomationId="GroupTabStrip"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        BorderThickness="0"
                        Background="Transparent"
                        VerticalAlignment="Stretch"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        SelectionChanged="OnStripSelectionChanged"
                        Loaded="OnStripListLoaded"
                        SizeChanged="OnStripListSizeChanged"
                        PreviewMouseLeftButtonDown="OnStripPreviewLeftDown"
                        PreviewMouseMove="OnStripPreviewMouseMove"
                        PreviewMouseWheel="OnTabStripPreviewWheel">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin"  Value="1,0" />
                                <Setter Property="MinWidth" Value="140" />
                                <Setter Property="MaxWidth" Value="280" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <!-- SessionTabViewModel.AutomationId — wpf-cli snapshots
                                     resolve to a:Tab_<displayName> instead of the VM type. -->
                                <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid MouseDown="OnTabMouseDown">
                                                <Grid.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem
                                                            AutomationProperties.AutomationId="TabCtx_Rename"
                                                            Header="Rename…"
                                                            Command="{Binding DataContext.RenameSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                        <MenuItem
                                                            AutomationProperties.AutomationId="TabCtx_Duplicate"
                                                            Header="Duplicate"
                                                            Command="{Binding DataContext.DuplicateTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                        <MenuItem
                                                            AutomationProperties.AutomationId="TabCtx_Close"
                                                            Header="Close"
                                                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Border
                                                    x:Name="TabPill"
                                                    Background="Transparent"
                                                    TextElement.Foreground="{DynamicResource Fig.Brush.InkDim}"
                                                    CornerRadius="0"
                                                    Margin="0"
                                                    Padding="12,0">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                                <!-- Per-tab rail removed in Tab Motion pass — the active accent
                                                     rail is now a single sibling of StripList positioned by
                                                     GroupStripView.xaml.cs so it animates between tabs on select. -->
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabPill" Property="Background" Value="{DynamicResource Fig.Brush.Canvas}" />
                                                    <Setter TargetName="TabPill" Property="TextElement.Foreground" Value="{DynamicResource Fig.Brush.Ink}" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                        <Condition Property="IsSelected" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="TabPill" Property="Background" Value="{DynamicResource Surface.Elev}" />
                                                    <Setter TargetName="TabPill" Property="TextElement.Foreground" Value="{DynamicResource Fig.Brush.Ink}" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionTabViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 6px status dot + optional pulsing halo when Status == Busy
                                         (mirrors the sidebar dot). The halo is a second Ellipse
                                         that only renders when busy — animated via Storyboard
                                         triggered on the tab Status value. -->
                                    <Grid Grid.Column="0" Width="6" Height="6"
                                          VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse x:Name="TabBusyHalo"
                                                 Width="6" Height="6"
                                                 Stroke="{DynamicResource Signal.Warn}"
                                                 StrokeThickness="1"
                                                 Fill="Transparent"
                                                 Opacity="0"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <Ellipse Width="6" Height="6"
                                                 Fill="{Binding Status, Converter={StaticResource TabDotBrush}}" />
                                    </Grid>
                                    <!-- Spec §4 variable-weight Inter: unselected tabs read at
                                         weight 340 so selected tabs win hierarchy by weight in
                                         addition to their ink/canvas contrast. TextFormattingMode
                                         Ideal preserves sub-integer weights in WPF's text stack. -->
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding DisplayName}"
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        FontFamily="{DynamicResource Fig.Font.Sans}"
                                        FontSize="13"
                                        TextOptions.TextFormattingMode="Ideal">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="340" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="FontWeight" Value="Medium" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Button
                                        x:Name="CloseButton"
                                        AutomationProperties.AutomationId="TabCloseBtn"
                                        Grid.Column="2"
                                        Width="14" Height="14"
                                        Margin="6,4,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource Fig.Brush.InkMuted}"
                                        Visibility="Hidden"
                                        Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="CloseBg"
                                                        Background="Transparent"
                                                        CornerRadius="7">
                                                    <!-- × has no descender so its optical centre
                                                         sits above the text line-box centre; LineHeight
                                                         locks the box to cap-height and a 1px bottom
                                                         padding nudges the glyph into the circle. -->
                                                    <TextBlock
                                                        Text="×"
                                                        FontFamily="{DynamicResource Fig.Font.Sans}"
                                                        FontSize="14"
                                                        LineHeight="14"
                                                        LineStackingStrategy="BlockLineHeight"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Padding="0,0,0,1"
                                                        UseLayoutRounding="True"
                                                        Foreground="{TemplateBinding Foreground}" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CloseBg" Property="Background" Value="#1F1F1F" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Fig.Brush.Ink}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}" Value="True">
                                        <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <!-- Busy-state halo pulse: 1.4s loop scaling 1→2.4× while
                                         fading opacity .55→0. Same timing as the sidebar pulse
                                         so the two dots read as one system. -->
                                    <DataTrigger Binding="{Binding Status}" Value="Busy">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="TabBusyPulse">
                                                <Storyboard RepeatBehavior="Forever" Duration="0:0:1.4">
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TabBusyHalo" Storyboard.TargetProperty="Opacity">
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TabBusyHalo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:1" Value="2.4" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="2.4" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TabBusyHalo" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                        <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:1" Value="2.4" />
                                                        <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="2.4" />
                                                    </DoubleAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="TabBusyPulse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Shared accent rail — one Border for the whole strip, positioned by
                         GroupStripView.xaml.cs. Canvas host so Left animates independently
                         of layout flow; IsHitTestVisible="False" so it never steals clicks. -->
                    <Canvas
                        VerticalAlignment="Top"
                        Height="3"
                        IsHitTestVisible="False">
                        <Border
                            x:Name="TabRail"
                            Background="{DynamicResource Accent.Primary}"
                            CornerRadius="0"
                            Height="3"
                            Width="0"
                            Canvas.Left="0"
                            Opacity="0"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                            <Border.Effect>
                                <DropShadowEffect
                                    Color="#0099FF"
                                    BlurRadius="12"
                                    ShadowDepth="0"
                                    Opacity="0.45" />
                            </Border.Effect>
                        </Border>
                    </Canvas>
                    </Grid>
                    <!-- New-session button pinned right of tabs. Slightly bigger so it
                         reads as a primary control; no agent-picker dropdown — default
                         agent only. In the rightmost group the window caption cluster
                         overlays the strip's far right; use Ctrl+T if this button ends
                         up under the overlay. -->
                    <Button
                        AutomationProperties.AutomationId="NewSessionBtn"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource Text.Faint}"
                        Width="32" Height="32"
                        Margin="6,0,0,0"
                        Padding="0"
                        FontSize="20"
                        VerticalAlignment="Center"
                        ToolTip="New session (Ctrl+T)"
                        Content="+"
                        Command="{Binding DataContext.NewSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </DockPanel>

        </Grid>
    </Border>
</UserControl>
