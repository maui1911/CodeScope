<UserControl
    x:Class="NoScope.CodeScope.Ui.Views.SidebarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:NoScope.CodeScope.Ui.ViewModels"
    Background="{DynamicResource Surface.Panel}"
    TextElement.Foreground="{DynamicResource Fig.Brush.Ink}"
    TextElement.FontFamily="{DynamicResource Fig.Font.Sans}"
    TextElement.FontSize="{DynamicResource Fig.Size.BodySmall}"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <BooleanToVisibilityConverter x:Key="BoolVisible" />

        <!-- Overview button — matches the mock: dark elev bg, left-accent bar when active,
             mono ⌃⇧O keycap floated right. When IsOverviewVisible is true on the window VM,
             the "active" look kicks in via a DataTrigger. -->
        <Style x:Key="Sidebar.FootButton" TargetType="Button">
            <Setter Property="Background"  Value="{DynamicResource Surface.Elev}" />
            <Setter Property="Foreground"  Value="{DynamicResource Text.Primary}" />
            <Setter Property="FontFamily"  Value="{DynamicResource Fig.Font.Sans}" />
            <Setter Property="FontSize"    Value="{DynamicResource Fig.Size.BodySmall}" />
            <Setter Property="FontWeight"  Value="Medium" />
            <Setter Property="Padding"     Value="12,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor"      Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Height"      Value="36" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Accent.Primary}"
                                BorderThickness="0,0,0,0"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                TextBlock.Foreground="{TemplateBinding Foreground}"
                                TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF1F1F1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Sidebar.OverviewButton" TargetType="Button" BasedOn="{StaticResource Sidebar.FootButton}">
            <Style.Triggers>
                <!-- Active look: accent text + accent bar on the left edge + subtle blue-tinted bg. -->
                <DataTrigger Binding="{Binding DataContext.IsOverviewVisible, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
                    <Setter Property="Background" Value="{DynamicResource Surface.AccentRowBg}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource Accent.Primary}"
                                        BorderThickness="2,0,0,0"
                                        CornerRadius="6"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter
                                        Margin="10,0,12,0"
                                        VerticalAlignment="Center"
                                        TextBlock.Foreground="{TemplateBinding Foreground}"
                                        TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                        TextBlock.FontSize="{TemplateBinding FontSize}" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Sidebar.NewProjectButton" TargetType="Button" BasedOn="{StaticResource Sidebar.FootButton}">
            <!-- Spec §11: 40px tall, flush-left 2px accent rail, larger font — signature CTA. -->
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Accent.Primary}"
                                BorderThickness="2,0,0,0"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="12,0,12,0"
                                VerticalAlignment="Center"
                                TextBlock.Foreground="{TemplateBinding Foreground}"
                                TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF1F1F1F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- PROJECTS label -->
            <RowDefinition Height="*" />     <!-- tree -->
            <RowDefinition Height="Auto" />  <!-- foot: Overview + New project -->
        </Grid.RowDefinitions>

        <!-- Brand lives in the MainWindow title-bar strip (Grid.Row=0 Col=0) now —
             see MainWindow.xaml. The sidebar starts directly with the PROJECTS label. -->
        <TextBlock
            Grid.Row="0"
            Text="PROJECTS"
            FontFamily="{DynamicResource Fig.Font.Sans}"
            FontSize="11"
            FontWeight="Medium"
            Typography.Capitals="AllSmallCaps"
            Foreground="{DynamicResource Text.Faint}"
            Margin="14,16,14,8"
            Visibility="{Binding HasProjects, Converter={StaticResource BoolVisible}}" />

        <!-- First-run empty hint: dashed box under PROJECTS when no projects exist
             (docs/design/html/CodeScope - Empty State.html §sidebar). -->
        <Border
            Grid.Row="1"
            VerticalAlignment="Top"
            Margin="12,4,12,0"
            Padding="12"
            CornerRadius="6"
            BorderThickness="1"
            BorderBrush="{DynamicResource Surface.Border}"
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisible}}">
            <Border.Resources>
                <!-- Dashed 1px border — WPF doesn't have a dashed Border stroke, so we draw
                     over a Rectangle with StrokeDashArray. -->
            </Border.Resources>
            <Grid>
                <Rectangle
                    Stroke="{DynamicResource Surface.Border}"
                    StrokeThickness="1"
                    StrokeDashArray="3,3"
                    RadiusX="6"
                    RadiusY="6"
                    Margin="-1" />
                <TextBlock
                    TextWrapping="Wrap"
                    FontFamily="{DynamicResource Fig.Font.Sans}"
                    FontSize="11.5"
                    LineHeight="17"
                    Foreground="{DynamicResource Text.Secondary}">
                    <Run Text="Nothing here yet." FontWeight="Medium" Foreground="{DynamicResource Text.Primary}" /><LineBreak />
                    <Run Text="Add a project to spin up worktrees and attach agent sessions. Drop a folder here or press " />
                    <Run FontFamily="{DynamicResource Fig.Font.Mono}" FontSize="10" Text=" ⌃N " />
                    <Run Text="." />
                </TextBlock>
            </Grid>
        </Border>

        <TreeView
            Grid.Row="1"
            x:Name="Tree"
            AutomationProperties.AutomationId="ProjectsTree"
            Visibility="{Binding HasProjects, Converter={StaticResource BoolVisible}}"
            ItemsSource="{Binding Projects}"
            Background="Transparent"
            BorderThickness="0"
            Foreground="{DynamicResource Fig.Brush.Ink}"
            SelectedItemChanged="OnTreeSelectionChanged"
            PreviewMouseRightButtonDown="OnTreePreviewRightClick"
            MouseDoubleClick="OnTreeDoubleClick"
            PreviewKeyDown="OnTreeKeyDown">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVisible}}" />
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="Foreground" Value="{DynamicResource Fig.Brush.Ink}" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Background" Value="Transparent" />
                    <!-- Bound off the data item: ProjectViewModel.AutomationId or
                         WorktreeViewModel.AutomationId (both expose the property). Wpf-cli
                         snapshots resolve to a:Project_<name> / a:Worktree_<id>__<branch>. -->
                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TreeViewItem">
                                <StackPanel>
                                    <!-- Minimal row chrome: a Border that hosts just the row content.
                                         The chevron now lives in the Project DataTemplate (not here) so
                                         worktree rows have zero chrome-side offset — the 2px session rail
                                         inside the Worktree DataTemplate can sit truly flush at sidebar x=0.
                                         Leaf rows (HasItems=False) also negative-margin the Border past the
                                         12px ItemsHost indent so the hover/selected fill spans edge-to-edge. -->
                                    <Border
                                        x:Name="RowBg"
                                        Background="{TemplateBinding Background}"
                                        Padding="0"
                                        MinHeight="28">
                                        <ContentPresenter
                                            ContentSource="Header"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center" />
                                    </Border>
                                    <ItemsPresenter
                                        x:Name="ItemsHost"
                                        Margin="0"
                                        Visibility="Collapsed" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsExpanded" Value="True">
                                        <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="RowBg" Property="Background" Value="#141414" />
                                    </Trigger>
                                    <!-- Selected row (spec §6: "active worktree" — #141414 fill). -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="RowBg" Property="Background" Value="#141414" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </TreeView.ItemsPanel>
            <!-- Disable horizontal scrolling; rows should always fit the sidebar column. -->
            <ScrollViewer.HorizontalScrollBarVisibility>Disabled</ScrollViewer.HorizontalScrollBarVisibility>
            <TreeView.Resources>
                <!-- Worktree row — matches codescope-shared.css .wt:
                       * 2px accent bar on the left when the worktree has sessions
                       * mono branch name
                       * right-aligned status slug ("chg" / "idle" / "wait" / "↑N ↓N") -->
                <!-- Worktrees are leaves — sessions live in the tab bar, not nested in the sidebar.
                     Matches the spec's two-level tree (project → worktree). -->
                <DataTemplate DataType="{x:Type vm:WorktreeViewModel}">
                    <Grid Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />  <!-- 2px session rail, flush at x=0 -->
                            <ColumnDefinition Width="34" />    <!-- indent to spec's 36px content gutter -->
                            <ColumnDefinition Width="Auto" />  <!-- 6px status dot -->
                            <ColumnDefinition Width="*" />     <!-- branch name -->
                            <ColumnDefinition Width="Auto" />  <!-- right-aligned meta -->
                        </Grid.ColumnDefinitions>

                        <!-- Sidebar spec §5 — full-height 2px accent bar on the left edge whenever
                             the worktree has a live session OR is the selected row. The outer
                             TreeViewItem template zeroed all chrome (no chevron col, no padding,
                             no ItemsHost indent), so the rail now sits flush with the sidebar's
                             x=0 with no escape trick needed. -->
                        <Rectangle
                            Grid.Column="0"
                            Width="3"
                            Margin="0,-1,0,-1"
                            HorizontalAlignment="Left"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"
                            Fill="{DynamicResource Accent.Primary}">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="Opacity" Value="0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveSession}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                            <Setter Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>

                        <!-- Sidebar spec §7 — 6px session-state dot (single source of truth;
                             same semantics as the tab-bar dot). Wait state pulses via a halo
                             ellipse scaled+faded by Storyboard. -->
                        <Grid Grid.Column="2" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                            <!-- pulsing halo (wait only) -->
                            <Ellipse
                                x:Name="DotHalo"
                                Width="6" Height="6"
                                Fill="{DynamicResource Signal.Warn}"
                                Opacity="0"
                                RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DotState}" Value="busy">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Name="BusyPulse">
                                                        <Storyboard RepeatBehavior="Forever" Duration="0:0:1.4">
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0.55" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="0" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="0.55" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="2.4" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:0.7" Value="2.4" />
                                                                <LinearDoubleKeyFrame KeyTime="0:0:1.4" Value="1" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="BusyPulse" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- the dot itself — selection chrome lives on the row (bg + bold + rail);
                                 the dot is reserved for agent state so it never disappears under selection. -->
                            <Ellipse Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <!-- Rest: dim dot on the tree border color -->
                                        <Setter Property="Fill" Value="#FF2A2A2A" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DotState}" Value="idle">
                                                <Setter Property="Fill" Value="{DynamicResource Signal.Ok}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding DotState}" Value="busy">
                                                <Setter Property="Fill" Value="{DynamicResource Signal.Warn}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>

                        <TextBlock
                            Grid.Column="3"
                            Text="{Binding DisplayBranch}"
                            FontFamily="{DynamicResource Fig.Font.Mono}"
                            FontSize="11.5"
                            VerticalAlignment="Center"
                            TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- Rest: muted. Selected row: white + Medium weight (spec §6). -->
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                            <Setter Property="FontWeight" Value="Medium" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock
                            Grid.Column="4"
                            Margin="8,0,12,0"
                            Text="{Binding StatusLabel}"
                            FontFamily="{DynamicResource Fig.Font.Mono}"
                            FontSize="10"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Text.Faint}" />
                    </Grid>
                </DataTemplate>

                <!-- Project row — matches codescope-shared.css .proj:
                       * bold name on the left
                       * accent-blue worktree count right-aligned -->
                <HierarchicalDataTemplate DataType="{x:Type vm:ProjectViewModel}" ItemsSource="{Binding Worktrees}">
                 <StackPanel>
                    <Grid Height="36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="12" />   <!-- left pad (spec §4 project pad: 0 12px) -->
                            <ColumnDefinition Width="12" />   <!-- chevron slot -->
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /> <!-- wait-propagation dot -->
                            <ColumnDefinition Width="Auto" /> <!-- count badge -->
                        </Grid.ColumnDefinitions>

                        <!-- Chevron — rotates 0→90° when the project expands (spec §4). Bound to the
                             ancestor TreeViewItem's IsExpanded (not VM's, because the outer template
                             uses TreeViewItem.IsExpanded to drive ItemsHost visibility). Wrapped
                             in a transparent hit-target Border so clicking the chevron toggles
                             expand/collapse (without this, the Path's stroke-only hit area means
                             most clicks miss and the row swallows them as selection). -->
                        <Border
                            Grid.Column="1"
                            Background="Transparent"
                            Cursor="Hand"
                            ToolTip="Expand / collapse"
                            PreviewMouseLeftButtonDown="OnChevronClick">
                            <Path
                                Width="10" Height="10"
                                Stretch="Uniform"
                                Data="M4.5 3 L8 6 L4.5 9"
                                Stroke="{DynamicResource Text.Secondary}"
                                StrokeThickness="1.5"
                                StrokeStartLineCap="Round"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                RenderTransformOrigin="0.5,0.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Path=IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="90" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Border>

                        <TextBlock
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Text="{Binding Name}"
                            FontWeight="Medium"
                            FontSize="13"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Text.Primary}"
                            TextTrimming="CharacterEllipsis" />

                        <!-- Sidebar spec §9: collapsed project surfaces a red dot next to its
                             count when any child worktree's session is busy (agent working). -->
                        <Ellipse
                            Grid.Column="3"
                            Width="6" Height="6"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Fill="{DynamicResource Signal.Warn}"
                            Visibility="{Binding HasBusyChild, Converter={StaticResource BoolVisible}}" />

                        <TextBlock
                            Grid.Column="4"
                            Margin="8,0,12,0"
                            Text="{Binding CountBadge}"
                            FontFamily="{DynamicResource Fig.Font.Mono}"
                            FontSize="11"
                            FontWeight="Medium"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Accent.Primary}" />
                    </Grid>

                    <!-- Empty-state placeholder: renders as a muted child row when the
                         project is expanded and has no worktrees so an empty project
                         doesn't look broken. Indent matches a real worktree row's left
                         gutter (3px rail + 34px indent). Hidden while the project is
                         collapsed — the chevron alone carries "nothing here". -->
                    <TextBlock
                        Margin="37,0,12,8"
                        Text="(no worktrees)"
                        FontFamily="{DynamicResource Fig.Font.Sans}"
                        FontSize="12"
                        FontStyle="Italic"
                        Foreground="{DynamicResource Text.Faint}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasNoWorktrees}" Value="True" />
                                            <Condition Binding="{Binding Path=IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                 </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
            <TreeView.ContextMenu>
                <ContextMenu x:Name="TreeContextMenu" />
            </TreeView.ContextMenu>
        </TreeView>

        <!-- Foot: Overview + New project, stacked, separated from the tree by a divider.
             Both buttons match the sidebar-foot styling from the HTML reference
             (codescope-shared.css .overview-btn + .new-project). -->
        <Border
            Grid.Row="2"
            BorderBrush="{DynamicResource Surface.Border}"
            BorderThickness="0,1,0,0"
            Padding="8">
            <StackPanel>
                <Button
                    AutomationProperties.AutomationId="OverviewBtn"
                    Style="{StaticResource Sidebar.OverviewButton}"
                    ToolTip="Overview — all sessions (Ctrl+Shift+O)"
                    Command="{Binding DataContext.ToggleOverviewCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="Overview"
                            VerticalAlignment="Center" />
                        <Border
                            Grid.Column="1"
                            Padding="5,1"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource Surface.Border}"
                            CornerRadius="3">
                            <TextBlock
                                Text="⌃⇧ O"
                                FontFamily="{DynamicResource Fig.Font.Mono}"
                                FontSize="10"
                                Foreground="{DynamicResource Text.Faint}" />
                        </Border>
                    </Grid>
                </Button>

                <Button
                    AutomationProperties.AutomationId="NewProjectBtn"
                    Margin="0,6,0,0"
                    Style="{StaticResource Sidebar.NewProjectButton}"
                    Command="{Binding AddProjectCommand}"
                    ToolTip="Add a new project to the sidebar">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Text="＋"
                            FontFamily="{DynamicResource Fig.Font.Mono}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource Accent.Primary}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Margin="8,0,0,0"
                            Text="New Project"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
