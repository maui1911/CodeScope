<UserControl
    x:Class="NoScope.CodeScope.Ui.Views.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:NoScope.CodeScope.Ui.ViewModels"
    xmlns:conv="clr-namespace:NoScope.CodeScope.Ui.Converters"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisible" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />

        <!-- 6px session-state dot. Brush swaps on status; wait pulses the halo. -->
        <Style x:Key="SbDot" TargetType="{x:Type Ellipse}">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{DynamicResource Signal.Ok}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusDotState}" Value="active">
                    <Setter Property="Fill" Value="{DynamicResource Accent.Primary}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#0099FF" BlurRadius="10" Opacity="0.6" ShadowDepth="0" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusDotState}" Value="wait">
                    <Setter Property="Fill" Value="{DynamicResource Signal.Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Item text defaults — mono, dim secondary ink. -->
        <Style x:Key="SbText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource Fig.Font.Mono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource Fig.Brush.InkMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SbTextMeta" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SbText}">
            <Setter Property="Foreground" Value="{DynamicResource Fig.Brush.InkDim}" />
        </Style>

        <Style x:Key="SbBranch" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{DynamicResource Fig.Font.Mono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#FFFFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 1 × 14 cluster separator -->
        <Style x:Key="SbSep" TargetType="{x:Type Rectangle}">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Fill" Value="{DynamicResource Surface.Border}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Cluster item container — 6px icon-to-text gap, 14px inter-item via parent. -->
        <Style x:Key="SbItem" TargetType="{x:Type StackPanel}">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border
        Height="32"
        Background="#0A0A0A"
        BorderBrush="{DynamicResource Surface.Border}"
        BorderThickness="0,1,0,0"
        Padding="12,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />   <!-- left cluster -->
                <ColumnDefinition Width="*" />      <!-- spacer -->
                <ColumnDefinition Width="Auto" />   <!-- right cluster -->
            </Grid.ColumnDefinitions>

            <!-- ============ LEFT: session context + git + diagnostics ============ -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding StatusHasSession, Converter={StaticResource BoolVisible}}">

                <!-- 1. Session context: dot + branch -->
                <StackPanel Style="{StaticResource SbItem}" Margin="0,0,14,0">
                    <Ellipse Style="{StaticResource SbDot}" Margin="0,0,6,0" />
                    <TextBlock Style="{StaticResource SbBranch}"
                               Text="{Binding StatusBranch}" />
                </StackPanel>

                <!-- Separator between session cluster and git cluster -->
                <Rectangle Style="{StaticResource SbSep}" Margin="0,0,14,0" />

                <!-- 2. Git dirty state — +N −N per spec callout #3 -->
                <StackPanel Style="{StaticResource SbItem}"
                            Margin="0,0,14,0"
                            Visibility="{Binding StatusIsDirty, Converter={StaticResource BoolVisible}}">
                    <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                          Stroke="{DynamicResource Fig.Brush.InkDim}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 3 3 L 3 9 M 3 6 Q 6 6 8 6 M 3 3 m -1.2 0 a 1.2 1.2 0 1 0 2.4 0 a 1.2 1.2 0 1 0 -2.4 0 M 3 9 m -1.2 0 a 1.2 1.2 0 1 0 2.4 0 a 1.2 1.2 0 1 0 -2.4 0 M 9 6 m -1.2 0 a 1.2 1.2 0 1 0 2.4 0 a 1.2 1.2 0 1 0 -2.4 0" />
                    <!-- With numstat data: additions white, deletions dim -->
                    <TextBlock Style="{StaticResource SbText}" Foreground="#FFFFFFFF"
                               Text="{Binding StatusAddedText}"
                               Margin="0,0,4,0"
                               Visibility="{Binding StatusHasAdded, Converter={StaticResource BoolVisible}}" />
                    <TextBlock Style="{StaticResource SbTextMeta}"
                               Text="{Binding StatusRemovedText}"
                               Visibility="{Binding StatusHasRemoved, Converter={StaticResource BoolVisible}}" />
                    <!-- Fallback: dirty indicator when numstat didn't yield line counts (untracked-only, binary, pending first poll) -->
                    <TextBlock Text="changes">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource SbTextMeta}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding StatusHasAdded}" Value="False" />
                                            <Condition Binding="{Binding StatusHasRemoved}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- 3. Remote sync ↑↓ -->
                <StackPanel Style="{StaticResource SbItem}"
                            Margin="0,0,14,0"
                            Visibility="{Binding StatusHasRemoteDelta, Converter={StaticResource BoolVisible}}">
                    <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                          Stroke="{DynamicResource Fig.Brush.InkDim}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 6 2 L 6 8 M 3.5 5.5 L 6 8 L 8.5 5.5 M 2.5 10 L 9.5 10" />
                    <TextBlock Style="{StaticResource SbText}" Foreground="#FFFFFFFF"
                               Text="{Binding StatusAheadBehindText}" />
                </StackPanel>
            </StackPanel>

            <!-- Empty-state tagline (no projects) -->
            <TextBlock Grid.Column="0"
                       Style="{StaticResource SbTextMeta}"
                       VerticalAlignment="Center"
                       Typography.Capitals="AllSmallCaps"
                       Text="{Binding StatusEmptyMessage}"
                       Visibility="{Binding StatusEmptyVisible, Converter={StaticResource BoolVisible}}" />

            <!-- ============ RIGHT: model + agents + tab count ============ -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- 7. Model (agent powering the focused session) -->
                <StackPanel Style="{StaticResource SbItem}"
                            Margin="0,0,14,0"
                            Visibility="{Binding StatusHasSession, Converter={StaticResource BoolVisible}}">
                    <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                          Stroke="{DynamicResource Fig.Brush.InkDim}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 6 1.5 L 10 3.5 L 10 8.5 L 6 10.5 L 2 8.5 L 2 3.5 Z M 6 5.5 L 10 3.5 M 6 5.5 L 2 3.5 M 6 5.5 L 6 10.5" />
                    <TextBlock Style="{StaticResource SbText}" Text="{Binding StatusModelName}" />
                </StackPanel>

                <!-- 8/9. Per-session tokens + turn count from the Claude transcript tail -->
                <StackPanel Style="{StaticResource SbItem}"
                            Margin="0,0,14,0"
                            Visibility="{Binding StatusTokensVisible, Converter={StaticResource BoolVisible}}">
                    <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                          Stroke="{DynamicResource Fig.Brush.InkDim}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 2 3 L 10 3 M 2 6 L 10 6 M 2 9 L 7 9" />
                    <TextBlock Style="{StaticResource SbText}" Foreground="#FFFFFFFF"
                               Text="{Binding StatusTokensText}" />
                    <TextBlock Style="{StaticResource SbTextMeta}" Text=" tok" />
                    <TextBlock Style="{StaticResource SbTextMeta}" Margin="6,0,0,0"
                               Text="{Binding StatusTokensPercentText}"
                               Visibility="{Binding StatusTokensPercentVisible, Converter={StaticResource BoolVisible}}" />
                </StackPanel>

                <StackPanel Style="{StaticResource SbItem}"
                            Margin="0,0,14,0"
                            Visibility="{Binding StatusTurnsVisible, Converter={StaticResource BoolVisible}}">
                    <TextBlock Style="{StaticResource SbTextMeta}" Text="{Binding StatusTurnsText}" />
                </StackPanel>

                <!-- Wall-clock of the most recent user → assistant turn -->
                <StackPanel Style="{StaticResource SbItem}"
                            Margin="0,0,14,0"
                            Visibility="{Binding StatusTurnDurationVisible, Converter={StaticResource BoolVisible}}">
                    <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"
                          Stroke="{DynamicResource Fig.Brush.InkDim}" StrokeThickness="1.4"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 6 1.5 A 4.5 4.5 0 1 0 6 10.5 A 4.5 4.5 0 1 0 6 1.5 M 6 3.5 L 6 6 L 8 7" />
                    <TextBlock Style="{StaticResource SbTextMeta}" Text="{Binding StatusTurnDurationText}" />
                </StackPanel>

                <Rectangle Style="{StaticResource SbSep}" Margin="0,0,14,0"
                           Visibility="{Binding StatusAgentSummaryVisible, Converter={StaticResource BoolVisible}}" />

                <!-- 10. Agent rollup (workspace-wide) -->
                <StackPanel Style="{StaticResource SbItem}"
                            Margin="0,0,14,0"
                            Visibility="{Binding StatusAgentSummaryVisible, Converter={StaticResource BoolVisible}}">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent.Primary}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource SbText}">
                        <Run Foreground="#FFFFFFFF" Text="{Binding StatusAgentActive, Mode=OneWay}" />
                        <Run Text=" active" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SbTextMeta}" Margin="6,0" Text="·" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Signal.Ok}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource SbText}">
                        <Run Foreground="#FFFFFFFF" Text="{Binding StatusAgentIdle, Mode=OneWay}" />
                        <Run Text=" idle" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource SbTextMeta}" Margin="6,0" Text="·" />
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Signal.Warn}" Margin="0,0,4,0" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource SbText}">
                        <Run Foreground="#FFFFFFFF" Text="{Binding StatusAgentWait, Mode=OneWay}" />
                        <Run Text=" wait" />
                    </TextBlock>
                </StackPanel>

                <Rectangle Style="{StaticResource SbSep}" Margin="0,0,14,0"
                           Visibility="{Binding StatusGroupCountVisible, Converter={StaticResource BoolVisible}}" />

                <!-- Group count (only when multiple groups) -->
                <TextBlock Style="{StaticResource SbText}"
                           Text="{Binding StatusGroupCountText}"
                           Margin="0,0,14,0"
                           Visibility="{Binding StatusGroupCountVisible, Converter={StaticResource BoolVisible}}" />

                <!-- Workspace summary: worktree count + dirty/PR/CI breakdown.
                     Per-field bindings let the segments hide individually when zero. -->
                <TextBlock Style="{StaticResource SbTextMeta}"
                           Text="{Binding StatusWorktreeCountText}"
                           Typography.Capitals="AllSmallCaps"
                           Visibility="{Binding StatusWorkspaceVisible, Converter={StaticResource BoolVisible}}" />
                <TextBlock Style="{StaticResource SbTextMeta}"
                           Margin="6,0,0,0"
                           Text="·"
                           Visibility="{Binding StatusDirtyVisible, Converter={StaticResource BoolVisible}}" />
                <TextBlock Style="{StaticResource SbTextMeta}"
                           Margin="6,0,0,0"
                           Text="{Binding StatusDirtyCountText}"
                           Typography.Capitals="AllSmallCaps"
                           Visibility="{Binding StatusDirtyVisible, Converter={StaticResource BoolVisible}}" />
                <TextBlock Style="{StaticResource SbTextMeta}"
                           Margin="6,0,0,0"
                           Text="·"
                           Visibility="{Binding StatusPrVisible, Converter={StaticResource BoolVisible}}" />
                <TextBlock Style="{StaticResource SbTextMeta}"
                           Margin="6,0,0,0"
                           Text="{Binding StatusPrCountText}"
                           Typography.Capitals="AllSmallCaps"
                           Visibility="{Binding StatusPrVisible, Converter={StaticResource BoolVisible}}" />
                <TextBlock Style="{StaticResource SbTextMeta}"
                           Margin="6,0,0,0"
                           Text="·"
                           Visibility="{Binding StatusCiFailVisible, Converter={StaticResource BoolVisible}}" />
                <TextBlock Style="{StaticResource SbTextMeta}"
                           Margin="6,0,0,0"
                           Text="{Binding StatusCiFailCountText}"
                           Typography.Capitals="AllSmallCaps"
                           Visibility="{Binding StatusCiFailVisible, Converter={StaticResource BoolVisible}}" />

                <!-- 11. Notifications — bell glyph + 4px blue unread dot + popover -->
                <Rectangle Style="{StaticResource SbSep}" Margin="10,0,10,0"
                           Visibility="{Binding Notifications, Converter={StaticResource NullToVisibility}}" />
                <Button x:Name="BellButton"
                        AutomationProperties.AutomationId="BellButton"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4,4"
                        Cursor="Hand"
                        ToolTip="Notifications"
                        Visibility="{Binding Notifications, Converter={StaticResource NullToVisibility}}"
                        Command="{Binding Notifications.OpenCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#14FFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Width="14" Height="14">
                        <Path Stretch="Uniform"
                              Stroke="{DynamicResource Fig.Brush.InkMuted}" StrokeThickness="1.4"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="M 3 9 L 3 5.5 A 3 3 0 0 1 9 5.5 L 9 9 Z M 5 10.5 Q 6 11.2 7 10.5" />
                        <!-- 4px unread dot — top-right of the bell -->
                        <Ellipse Width="4" Height="4"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,0,0,0"
                                 Fill="{DynamicResource Accent.Primary}"
                                 Visibility="{Binding Notifications.HasUnread, Converter={StaticResource BoolVisible}}" />
                    </Grid>
                </Button>
                <Popup x:Name="BellPopup"
                       PlacementTarget="{Binding ElementName=BellButton}"
                       Placement="Top"
                       VerticalOffset="-6"
                       HorizontalOffset="0"
                       AllowsTransparency="True"
                       StaysOpen="False"
                       PopupAnimation="Fade"
                       IsOpen="{Binding Notifications.IsOpen, Mode=TwoWay}">
                    <Border Background="{DynamicResource Fig.Brush.SurfaceDialog}"
                            BorderBrush="{DynamicResource Surface.Border}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Fig.Radius.Medium}"
                            Width="360"
                            MaxHeight="420"
                            Padding="0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="24" Opacity="0.55" ShadowDepth="6" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="14,12,10,10">
                                <TextBlock Text="Notifications"
                                           FontFamily="{DynamicResource Fig.Font.Sans}"
                                           FontSize="12" FontWeight="Medium"
                                           Foreground="#FFFFFFFF"
                                           VerticalAlignment="Center" />
                                <Button AutomationProperties.AutomationId="NotificationsClearAllBtn"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="6,3"
                                        Cursor="Hand"
                                        Foreground="{DynamicResource Fig.Brush.InkDim}"
                                        FontFamily="{DynamicResource Fig.Font.Sans}"
                                        FontSize="11"
                                        Content="Clear"
                                        Command="{Binding Notifications.ClearAllCommand}"
                                        Visibility="{Binding Notifications.HasAny, Converter={StaticResource BoolVisible}}" />
                            </Grid>

                            <!-- Empty state -->
                            <TextBlock Grid.Row="1"
                                       Text="No notifications yet."
                                       FontFamily="{DynamicResource Fig.Font.Sans}"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Fig.Brush.InkDim}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,28,0,36">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Notifications.HasAny}" Value="False">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Entries -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding Notifications.HasAny, Converter={StaticResource BoolVisible}}">
                                <ItemsControl ItemsSource="{Binding Notifications.Entries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button AutomationProperties.AutomationId="{Binding Id, StringFormat='Notification_{0}'}"
                                                    Background="Transparent"
                                                    BorderThickness="0,1,0,0"
                                                    BorderBrush="{DynamicResource Surface.Border}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="14,10"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.Notifications.ActivateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#0EFFFFFF" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Kind dot -->
                                                    <Ellipse Grid.Column="0"
                                                             Width="6" Height="6"
                                                             Margin="0,5,10,0"
                                                             VerticalAlignment="Top">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{DynamicResource Fig.Brush.InkDim}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="SessionWaiting">
                                                                        <Setter Property="Fill" Value="{DynamicResource Signal.Warn}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Kind}" Value="SessionReady">
                                                                        <Setter Property="Fill" Value="{DynamicResource Accent.Primary}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontFamily="{DynamicResource Fig.Font.Sans}"
                                                                   FontSize="12"
                                                                   FontWeight="Medium"
                                                                   Foreground="#FFFFFFFF" />
                                                        <TextBlock Text="{Binding Detail}"
                                                                   FontFamily="{DynamicResource Fig.Font.Sans}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource Fig.Brush.InkMuted}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding SessionTitle}"
                                                                   FontFamily="{DynamicResource Fig.Font.Mono}"
                                                                   FontSize="10.5"
                                                                   Foreground="{DynamicResource Fig.Brush.InkDim}"
                                                                   Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <!-- Timestamp -->
                                                    <TextBlock Grid.Column="2"
                                                               FontFamily="{DynamicResource Fig.Font.Mono}"
                                                               FontSize="10.5"
                                                               Foreground="{DynamicResource Fig.Brush.InkDim}"
                                                               VerticalAlignment="Top"
                                                               Margin="10,1,0,0"
                                                               Text="{Binding Timestamp, StringFormat=HH:mm}" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Footer hint -->
                            <Border Grid.Row="2"
                                    BorderBrush="{DynamicResource Surface.Border}"
                                    BorderThickness="0,1,0,0"
                                    Padding="14,8">
                                <TextBlock FontFamily="{DynamicResource Fig.Font.Sans}"
                                           FontSize="10.5"
                                           Foreground="{DynamicResource Fig.Brush.InkDim}"
                                           Text="Click an entry to jump to its session." />
                            </Border>
                        </Grid>
                    </Border>
                </Popup>

            </StackPanel>
        </Grid>
    </Border>
</UserControl>
