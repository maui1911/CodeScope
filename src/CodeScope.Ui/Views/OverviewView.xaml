<UserControl
    x:Class="NoScope.CodeScope.Ui.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:NoScope.CodeScope.Ui.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{DynamicResource Surface.Canvas}"
    TextElement.Foreground="{DynamicResource Text.Primary}"
    TextElement.FontFamily="{DynamicResource Fig.Font.Sans}"
    TextElement.FontSize="{DynamicResource Fig.Size.Body}"
    d:DataContext="{d:DesignInstance Type=vm:OverviewViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisible" />

        <!-- Preview-line TextBlock: DataTrigger picks a foreground per Kind. -->
        <Style x:Key="Overview.PreviewLine" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Fig.Font.Mono}" />
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Prompt">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Accent">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Ok">
                    <Setter Property="Foreground" Value="{DynamicResource Signal.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Warn">
                    <Setter Property="Foreground" Value="{DynamicResource Signal.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Faint">
                    <Setter Property="Foreground" Value="{DynamicResource Text.Faint}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Segmented filter pill. IsChecked comes from the VM's FilterIsX bools; clicks fire
             SetFilterCommand with the CommandParameter. -->
        <Style x:Key="Overview.FilterPill" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{DynamicResource Fig.Font.Sans}" />
            <Setter Property="FontSize"   Value="11" />
            <Setter Property="Padding"    Value="10,5" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor"     Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource Surface.Border}"
                                BorderThickness="0"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextBlock.Foreground="{TemplateBinding Foreground}"
                                TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface.Canvas}" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Per-card button — invisible chrome, content fills. -->
        <Style x:Key="Overview.CardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardOuter"
                                Background="{DynamicResource Surface.Panel}"
                                BorderBrush="{DynamicResource Surface.Border}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Fig.Radius.Medium}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardOuter" Property="Background" Value="{DynamicResource Surface.Elev}" />
                                <Setter TargetName="CardOuter" Property="BorderBrush" Value="{DynamicResource Accent.Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Card status dot. Wrapper sets fill via trigger on the bound State enum. -->
        <Style x:Key="Overview.StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{DynamicResource Signal.Ok}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Active">
                    <Setter Property="Fill" Value="{DynamicResource Accent.Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Waiting">
                    <Setter Property="Fill" Value="{DynamicResource Signal.Warn}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dot ring halo (behind the 6px pip). -->
        <Style x:Key="Overview.StatusDotRing" TargetType="Ellipse">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Fill" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Active">
                    <Setter Property="Fill" Value="{DynamicResource Accent.Ring}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Waiting">
                    <Setter Property="Fill" Value="{DynamicResource Accent.Ring}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Changes chip border + text follow HasChanges. -->
        <Style x:Key="Overview.ChangesChip" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Surface.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent.Glow}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Overview.ChangesChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Fig.Font.Mono}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Text.Faint}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasChanges}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Accent.Primary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Surface.Canvas}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header strip -->
        <Border
            Grid.Row="0"
            Height="56"
            BorderBrush="{DynamicResource Surface.Border}"
            BorderThickness="0,0,0,1"
            Background="{DynamicResource Surface.Canvas}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- OVERVIEW eyebrow chip -->
                <Border
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Padding="7,3"
                    Background="#0D0099FF"
                    BorderBrush="#400099FF"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock
                        Text="OVERVIEW"
                        FontFamily="{DynamicResource Fig.Font.Mono}"
                        FontSize="10"
                        Foreground="{DynamicResource Accent.Primary}"
                        Typography.Capitals="AllSmallCaps" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding SubtitleBody}"
                    FontFamily="{DynamicResource Fig.Font.Sans}"
                    FontSize="{DynamicResource Fig.Size.Body}"
                    Foreground="{DynamicResource Text.Secondary}" />

                <!-- Filter pills -->
                <Border
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Surface.Elev}"
                    CornerRadius="5"
                    Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton
                            AutomationProperties.AutomationId="FilterAll"
                            Content="All"
                            Style="{StaticResource Overview.FilterPill}"
                            IsChecked="{Binding FilterIsAll, Mode=OneWay}"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="All" />
                        <ToggleButton
                            AutomationProperties.AutomationId="FilterActive"
                            Content="Active"
                            Style="{StaticResource Overview.FilterPill}"
                            IsChecked="{Binding FilterIsActive, Mode=OneWay}"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Active" />
                        <ToggleButton
                            AutomationProperties.AutomationId="FilterIdle"
                            Content="Idle"
                            Style="{StaticResource Overview.FilterPill}"
                            IsChecked="{Binding FilterIsIdle, Mode=OneWay}"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Idle" />
                        <ToggleButton
                            AutomationProperties.AutomationId="FilterWaiting"
                            Content="Waiting"
                            Style="{StaticResource Overview.FilterPill}"
                            IsChecked="{Binding FilterIsWaiting, Mode=OneWay}"
                            Command="{Binding SetFilterCommand}"
                            CommandParameter="Waiting" />
                    </StackPanel>
                </Border>

                <Button
                    AutomationProperties.AutomationId="BackToWorkspaceBtn"
                    Grid.Column="4"
                    Margin="14,0,0,0"
                    Style="{DynamicResource Fig.Style.Button.Ghost}"
                    Content="← Back to workspace"
                    Foreground="{DynamicResource Accent.Primary}"
                    FontSize="{DynamicResource Fig.Size.Body}"
                    Command="{Binding BackCommand}" />
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <!-- Grid of cards -->
            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ItemsControl
                    AutomationProperties.AutomationId="OverviewCardsGrid"
                    Padding="24"
                    ItemsSource="{Binding FilteredCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OverviewCardViewModel}">
                            <Button
                                AutomationProperties.AutomationId="OverviewCard"
                                AutomationProperties.Name="{Binding DisplayTitle}"
                                Width="360"
                                Height="260"
                                Margin="0,0,16,16"
                                Style="{StaticResource Overview.CardButton}"
                                Command="{Binding OpenCommand}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Head: sdot + title + open glyph -->
                                    <Grid Grid.Row="0" Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="18" Height="18" VerticalAlignment="Center">
                                            <Ellipse Style="{StaticResource Overview.StatusDotRing}" />
                                            <Ellipse Style="{StaticResource Overview.StatusDot}" />
                                        </Grid>

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{Binding DisplayTitle}"
                                            FontFamily="{DynamicResource Fig.Font.Sans}"
                                            FontSize="{DynamicResource Fig.Size.Body}"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource Text.Primary}"
                                            TextTrimming="CharacterEllipsis" />

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="⧉"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource Text.Faint}" />
                                    </Grid>

                                    <!-- Mini terminal preview -->
                                    <Border
                                        Grid.Row="1"
                                        Margin="8,0"
                                        Background="{DynamicResource Surface.Canvas}"
                                        CornerRadius="4"
                                        Padding="12,10">
                                        <ItemsControl ItemsSource="{Binding PreviewLines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:OverviewPreviewLine}">
                                                    <TextBlock
                                                        Text="{Binding Text}"
                                                        Style="{StaticResource Overview.PreviewLine}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- Footer: branch · changes chip · elapsed -->
                                    <Grid Grid.Row="2" Margin="12,8,12,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding BranchLabel}"
                                            FontFamily="{DynamicResource Fig.Font.Mono}"
                                            FontSize="11"
                                            Foreground="{DynamicResource Text.Secondary}"
                                            TextTrimming="CharacterEllipsis"
                                            VerticalAlignment="Center" />

                                        <Border
                                            Grid.Column="1"
                                            Margin="8,0"
                                            Style="{StaticResource Overview.ChangesChip}">
                                            <TextBlock
                                                Text="{Binding ChangesLabel}"
                                                Style="{StaticResource Overview.ChangesChipText}" />
                                        </Border>

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding ElapsedLabel}"
                                            FontFamily="{DynamicResource Fig.Font.Mono}"
                                            FontSize="10"
                                            Foreground="{DynamicResource Text.Faint}"
                                            VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisible}}">
                <TextBlock
                    Text="No active sessions"
                    FontSize="18"
                    FontWeight="Medium"
                    Foreground="{DynamicResource Text.Secondary}"
                    HorizontalAlignment="Center" />
                <TextBlock
                    Text="Start a new session from the sidebar or Ctrl+T — it will show up here."
                    Margin="0,6,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource Text.Faint}"
                    HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
