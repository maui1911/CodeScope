target/
Cargo.lock.bak

# Workspace members share the root Cargo.lock; per-member locks
# are stale artifacts from before the workspace conversion.
terminal/Cargo.lock

# vendor/gpui-terminal was cloned with its upstream history; we track
# the source files via the workspace, not as a submodule. The original
# `.git` directory was renamed to `.git-upstream-snapshot` so git on the
# outer repo sees regular files instead of an embedded repository.
vendor/gpui-terminal/.git/
vendor/gpui-terminal/.git-upstream-snapshot/
