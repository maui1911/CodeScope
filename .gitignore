# Rust build output (matches `target/` at any depth — root workspace,
# `vendor/gpui-terminal/`, `terminal/`, etc.)
target/
Cargo.lock.bak

# Stale per-member locks from before the workspace conversion — the
# workspace root Cargo.lock is the only one we track.
terminal/Cargo.lock

# vendor/gpui-terminal was cloned with its upstream history; we track
# the source files via the workspace, not as a submodule. The original
# `.git` directory was renamed to `.git-upstream-snapshot` so git on the
# outer repo sees regular files instead of an embedded repository.
vendor/gpui-terminal/.git/
vendor/gpui-terminal/.git-upstream-snapshot/

# Release / install artefacts
artifacts/
releases/

# JetBrains / VS Code / VS
.vs/
.idea/
.vscode/
*.ReSharper*

# Test results
TestResults/
coverage.*

# Logs
*.log

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Superpowers visual companion
.superpowers/

# Desloppify local state
.desloppify/

# Scratch area (never commit). Throwaway captures, session logs, and any
# tooling output that shouldn't ship. docs/screenshots/ is the tracked
# home for README imagery — only that folder is published.
scratch/
.scratch/

# Tool-state directories surfaced by AI / automation runners
.claude/
.playwright-cli/

# Dev build output (separate target dir used for side-by-side dev runs)
/target-dev/
