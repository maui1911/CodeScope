<Project>
    <!--
        Derives the product version from the current git tag at build time.
        git describe gives us: the tag when HEAD is exactly tagged, the tag
        plus commits-ahead and short SHA when ahead, or just the short SHA
        when no tags exist yet. "-dirty" is appended when the tree has
        uncommitted changes.

        The result is baked into AssemblyInformationalVersionAttribute so
        the UI (and any crash-report / about-dialog consumer) can read it
        at runtime. See CodeScope.App.VersionInfo.
    -->
    <Target Name="SetVersionFromGit"
            BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;CoreCompile">
        <!--
            `--match v*` restricts git describe to product-version
            tags (`v0.2.5`, `v0.3.0-rc1`). The Rust-side release
            pipeline cuts its own `rs-vX.Y.Z` tags in the same repo;
            without the filter, `git describe` would pick the most
            recent reachable tag of either flavour and stamp the C#
            informational version with `rs-v…`, which is wrong.
            See ADR-0019.
        -->
        <Exec Command="git describe --tags --always --dirty --match v*"
              ConsoleToMSBuild="true"
              IgnoreExitCode="true"
              ContinueOnError="true"
              StandardOutputImportance="low"
              StandardErrorImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribe" />
        </Exec>
        <PropertyGroup>
            <InformationalVersion Condition="'$(_GitDescribe)' != ''">$(_GitDescribe)</InformationalVersion>
            <InformationalVersion Condition="'$(_GitDescribe)' == ''">0.0-unknown</InformationalVersion>
        </PropertyGroup>
    </Target>
</Project>
